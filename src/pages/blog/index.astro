
---
import Header from "../../components/Header.astro";
import { getCollection } from "astro:content";
import "../../styles/global.css";

const siteName = "The Gray Journal";

const pageTitle = "The Journal | The Gray Journal";

const pageDescription =
  "Explore articles about technology, coding, creativity, personal experiences, learning, and everyday inspiration at The Gray Journal.";

const socialImage =
  "https://images.unsplash.com/photo-1511818966892-d7d671e672a2?auto=format&fit=crop&w=1200&h=630&q=85";

// Retrieve published blog articles
const allPosts = await getCollection("blog", ({ data }) => {
  return data.draft !== true;
});

// Sort articles from newest to oldest
const posts = allPosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Format publication dates
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }).format(date);
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={siteName} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f4f4f2" />

    <!-- OPEN GRAPH -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />

    <!-- TWITTER / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="blog-page">

  <Header />

    <main>

      <!-- BLOG HERO -->
      <section class="blog-hero container">

        <div class="blog-hero-content">

          <span class="eyebrow">
            <span class="status-dot"></span>
            THE GRAY JOURNAL
          </span>

          <h1>
            Ideas worth
            <span>exploring.</span>
          </h1>

          <p>
            A collection of thoughts, discoveries, tutorials,
            and stories about technology, creativity,
            personal growth, and everyday inspiration.
          </p>

          <div class="blog-hero-meta">
            <span>THE JOURNAL</span>
            <span class="meta-divider"></span>
            <span>{posts.length} {posts.length === 1 ? "ARTICLE" : "ARTICLES"}</span>
          </div>

        </div>

      </section>

      <!-- BLOG ARTICLES -->
      <section class="blog-listing container" id="articles">

        <div class="blog-section-heading">

          <div>
            <span class="section-label">
              01 — LATEST STORIES
            </span>

            <h2>Explore the journal.</h2>
          </div>

          <p>
            Thoughts and stories, one article at a time.
          </p>

        </div>

        {posts.length > 0 ? (

          <div class="blog-grid">

            {posts.map((post) => (

              <article class="blog-card">

                <a
                  href={`/blog/${post.id}/`}
                  class="blog-card-image-link"
                  aria-label={`Read ${post.data.title}`}
                >

                  {post.data.image ? (
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      class="blog-card-image"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="blog-card-image blog-card-image-placeholder">
                      <span>GJ.</span>
                    </div>
                  )}

                </a>

                <div class="blog-card-content">

                  <div class="blog-card-meta">
                    <span class="blog-category">
                      {post.data.category}
                    </span>

                    <span class="blog-date">
                      {formatDate(post.data.pubDate)}
                    </span>
                  </div>

                  <h3>
                    <a href={`/blog/${post.id}/`}>
                      {post.data.title}
                    </a>
                  </h3>

                  <p class="blog-card-description">
                    {post.data.description}
                  </p>

                  <div class="blog-card-footer">

                    <span class="blog-author">
                      By {post.data.author}
                    </span>

                    <a
                      href={`/blog/${post.id}/`}
                      class="text-link"
                    >
                      Read Article <span>→</span>
                    </a>

                  </div>

                </div>

              </article>

            ))}

          </div>

        ) : (

          <div class="blog-empty-state">

            <span class="section-label">
              THE JOURNAL
            </span>

            <h3>Stories are coming.</h3>

            <p>
              There are no published articles yet.
              Check back soon for new stories and ideas.
            </p>

          </div>

        )}

      </section>

      <!-- NEWSLETTER / CLOSING SECTION -->
      <section class="blog-closing">

        <div class="container blog-closing-content">

          <span class="section-label">
            02 — KEEP EXPLORING
          </span>

          <h2>
            Every idea has
            <span>a story.</span>
          </h2>

          <p>
            Thanks for spending some time here.
            Keep exploring, keep learning, and stay curious.
          </p>

          <a href="/" class="button button-primary">
            Back to Home <span>↗</span>
          </a>

        </div>

      </section>

    </main>

    <!-- FOOTER -->
    <footer class="site-footer">

      <div class="container footer-content">

        <a href="/" class="brand footer-brand">
          <span class="brand-mark">G.</span>
          <span>The Gray Journal</span>
        </a>

        <p>
          © {new Date().getFullYear()} The Gray Journal.
          All rights reserved.
        </p>

        <a href="#" class="back-to-top">
          Back to top ↑
        </a>

      </div>

    </footer>

  </body>
</html>

<script>
  import "../../scripts/theme.js";
</script>

<style>
  /* BLOG HERO */

  .blog-hero {
    padding-top: 110px;
    padding-bottom: 100px;
    min-height: 420px;
    display: flex;
    align-items: center;
  }

  .blog-hero-content {
    max-width: 760px;
  }

  .blog-hero h1 {
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.065em;
    font-weight: 500;
    margin: 25px 0;
  }

  .blog-hero h1 span,
  .blog-closing h2 span {
    display: block;
    color: #92928d;
  }

  .blog-hero-content > p {
    max-width: 590px;
    line-height: 1.8;
    color: var(--text-secondary, #777);
    font-size: 1.05rem;
  }

  .blog-hero-meta {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 35px;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    color: var(--text-secondary, #777);
  }

  /* BLOG LISTING */

  .blog-listing {
    padding-top: 75px;
    padding-bottom: 110px;
    border-top: 1px solid var(--border-color, #ddd);
  }

  .blog-section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 45px;
  }

  .blog-section-heading h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    margin-top: 15px;
  }

  .blog-section-heading > p {
    color: var(--text-secondary, #777);
    font-size: 0.9rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 35px 25px;
  }

  .blog-card {
    min-width: 0;
    border: 1px solid var(--border-color, #e1e1df);
    background: var(--card-background, transparent);
    overflow: hidden;
    transition: transform 0.25s ease;
  }

  .blog-card:hover {
    transform: translateY(-5px);
  }

  .blog-card-image-link {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: #e7e7e3;
  }

  .blog-card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .blog-card:hover .blog-card-image {
    transform: scale(1.04);
  }

  .blog-card-image-placeholder {
    display: grid;
    place-items: center;
    background: #e7e7e3;
    color: #777;
  }

  .blog-card-image-placeholder span {
    font-size: 3rem;
    font-weight: 500;
    letter-spacing: -0.08em;
  }

  .blog-card-content {
    padding: 25px;
  }

  .blog-card-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 0.72rem;
  }

  .blog-category {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .blog-date,
  .blog-author {
    color: var(--text-secondary, #777);
  }

  .blog-card h3 {
    font-size: 1.4rem;
    line-height: 1.3;
    letter-spacing: -0.035em;
    font-weight: 500;
    margin: 20px 0 12px;
  }

  .blog-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .blog-card h3 a:hover {
    color: #92928d;
  }

  .blog-card-description {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--text-secondary, #777);
    margin-bottom: 25px;
  }

  .blog-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 18px;
    border-top: 1px solid var(--border-color, #ddd);
    font-size: 0.78rem;
  }

  .blog-card-footer .text-link {
    white-space: nowrap;
  }

  /* EMPTY STATE */

  .blog-empty-state {
    text-align: center;
    padding: 90px 20px;
    border: 1px solid var(--border-color, #ddd);
  }

  .blog-empty-state h3 {
    font-size: 2rem;
    font-weight: 500;
    margin: 20px 0 10px;
  }

  .blog-empty-state p {
    color: var(--text-secondary, #777);
    line-height: 1.7;
  }

  /* CLOSING SECTION */

  .blog-closing {
    padding: 100px 0;
    background: var(--section-background, #eeefec);
  }

  .blog-closing-content {
    max-width: 650px;
  }

  .blog-closing h2 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.055em;
    margin: 25px 0;
  }

  .blog-closing p {
    color: var(--text-secondary, #777);
    line-height: 1.8;
    margin-bottom: 30px;
  }

  /* DARK THEME */

  html[data-theme="dark"] .blog-card-image-placeholder {
    background: #30302e;
    color: #bbb;
  }

  html[data-theme="dark"] .blog-closing {
    background: #242422;
  }

  html[data-theme="dark"] .blog-hero h1 span,
  html[data-theme="dark"] .blog-closing h2 span {
    color: #aaa9a3;
  }

  /* RESPONSIVE */

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .blog-hero {
      min-height: auto;
      padding-top: 75px;
      padding-bottom: 75px;
    }

    .blog-listing {
      padding-top: 55px;
      padding-bottom: 75px;
    }

    .blog-section-heading {
      display: block;
    }

    .blog-section-heading > p {
      margin-top: 15px;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .blog-card-content {
      padding: 20px;
    }

    .blog-closing {
      padding: 75px 0;
    }
  }
</style>
