
---
import Header from "../../components/Header.astro";
import { getCollection, render } from "astro:content";
import "../../styles/global.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => {
    return data.draft !== true;
  });

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const { Content } = await render(post);

const siteName = "The Gray Journal";
const pageTitle = `${post.data.title} | ${siteName}`;
const pageDescription = post.data.description;

const socialImage =
  post.data.image ||
  "https://images.unsplash.com/photo-1511818966892-d7d671e672a2?auto=format&fit=crop&w=1200&h=630&q=85";

const formattedDate = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(post.data.pubDate);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{pageTitle}</title>

    <meta name="description" content={pageDescription} />
    <meta name="author" content={post.data.author} />
    <meta name="robots" content="index, follow" />

    <!-- OPEN GRAPH -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="article:published_time" content={post.data.pubDate.toISOString()} />
    <meta property="article:author" content={post.data.author} />

    <!-- TWITTER / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="article-page">

  <Header />

    <main>

      <!-- ARTICLE HEADER -->
      <article class="container article-container">

        <a href="/blog/" class="article-back-link">
          ← Back to Articles
        </a>

        <header class="article-header">

          <span class="section-label">
            {post.data.category}
          </span>

          <h1>{post.data.title}</h1>

          <p class="article-description">
            {post.data.description}
          </p>

          <div class="article-meta">
            <span>By {post.data.author}</span>
            <span class="meta-divider"></span>
            <time datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>
          </div>

        </header>

        <!-- FEATURED IMAGE -->
        {post.data.image && (
          <div class="article-featured-image">
            <img
              src={post.data.image}
              alt={post.data.title}
              fetchpriority="high"
            />
          </div>
        )}

        <!-- ARTICLE CONTENT -->
        <div class="article-content">

          <Content />

        </div>

        <!-- TAGS -->
        {post.data.tags.length > 0 && (
          <div class="article-tags">
            <span>Tags:</span>

            {post.data.tags.map((tag) => (
              <span class="article-tag">{tag}</span>
            ))}
          </div>
        )}

        <!-- ARTICLE FOOTER -->
        <footer class="article-footer">

          <div>
            <span class="section-label">THE GRAY JOURNAL</span>
            <h2>Thank you for reading.</h2>
            <p>Keep exploring, learning, and finding inspiration.</p>
          </div>

          <a href="/blog/" class="button button-primary">
            Explore More Articles <span>↗</span>
          </a>

        </footer>

      </article>

    </main>

    <!-- FOOTER -->
    <footer class="site-footer">

      <div class="container footer-content">

        <a href="/" class="brand footer-brand">
          <span class="brand-mark">G.</span>
          <span>The Gray Journal</span>
        </a>

        <p>
          © {new Date().getFullYear()} The Gray Journal.
          All rights reserved.
        </p>

        <a href="/" class="back-to-top">
          Back to Home ↑
        </a>

      </div>

    </footer>

  </body>
</html>

<script>
  import "../../scripts/theme.js";
</script>

<style>
  .article-container {
    padding-top: 65px;
    padding-bottom: 100px;
  }

  .article-back-link {
    display: inline-block;
    text-decoration: none;
    color: var(--text-secondary, #777);
    font-size: 0.85rem;
    margin-bottom: 55px;
  }

  .article-back-link:hover {
    color: var(--text-primary, #222);
  }

  .article-header {
    max-width: 850px;
    margin: 0 auto 55px;
    text-align: center;
  }

  .article-header h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.06em;
    font-weight: 500;
    margin: 25px 0;
  }

  .article-description {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-secondary, #777);
    max-width: 700px;
    margin: 0 auto;
  }

  .article-meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    flex-wrap: wrap;
    margin-top: 30px;
    font-size: 0.8rem;
    color: var(--text-secondary, #777);
  }

  .article-featured-image {
    max-width: 1050px;
    margin: 0 auto 70px;
    aspect-ratio: 16 / 8;
    overflow: hidden;
  }

  .article-featured-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-content {
    max-width: 760px;
    margin: 0 auto;
    font-size: 1.05rem;
    line-height: 1.9;
    overflow-wrap: break-word;
  }

  .article-content h1,
  .article-content h2,
  .article-content h3 {
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.3;
    margin-top: 45px;
    margin-bottom: 18px;
  }

  .article-content h1 {
    font-size: 2.2rem;
  }

  .article-content h2 {
    font-size: 1.8rem;
  }

  .article-content h3 {
    font-size: 1.4rem;
  }

  .article-content p {
    margin-bottom: 24px;
    color: var(--text-secondary, #777);
  }

  .article-content ul,
  .article-content ol {
    padding-left: 25px;
    margin-bottom: 25px;
  }

  .article-content li {
    margin-bottom: 10px;
  }

  .article-content a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-content blockquote {
    border-left: 3px solid #999;
    padding-left: 25px;
    margin: 35px 0;
    color: var(--text-secondary, #777);
  }

  .article-tags {
    max-width: 760px;
    margin: 55px auto;
    padding-top: 25px;
    border-top: 1px solid var(--border-color, #ddd);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-size: 0.8rem;
  }

  .article-tag {
    padding: 7px 13px;
    border: 1px solid var(--border-color, #ddd);
    border-radius: 30px;
  }

  .article-footer {
    max-width: 1050px;
    margin: 90px auto 0;
    padding: 55px 0;
    border-top: 1px solid var(--border-color, #ddd);
    border-bottom: 1px solid var(--border-color, #ddd);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 30px;
  }

  .article-footer h2 {
    font-size: 2rem;
    font-weight: 500;
    margin: 15px 0;
    letter-spacing: -0.04em;
  }

  .article-footer p {
    color: var(--text-secondary, #777);
    line-height: 1.7;
  }

  html[data-theme="dark"] .article-content p {
    color: var(--text-secondary, #aaa);
  }

  @media (max-width: 650px) {
    .article-container {
      padding-top: 40px;
      padding-bottom: 70px;
    }

    .article-back-link {
      margin-bottom: 40px;
    }

    .article-featured-image {
      aspect-ratio: 4 / 3;
      margin-bottom: 45px;
    }

    .article-footer {
      flex-direction: column;
      align-items: flex-start;
    }

    .article-footer h2 {
      font-size: 1.7rem;
    }
  }
</style>
